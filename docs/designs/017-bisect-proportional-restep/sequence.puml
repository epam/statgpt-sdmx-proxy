@startuml Heuristic Limit Emulation - Request Sequence

title Heuristic Limit Emulation - Request Flow (BIS 3.0 example, limit=80)

actor Client
participant "DataQuery30\nController" as C
participant "AdapterRouter\nImpl" as R
participant "LimitEmulation\nService" as L
participant "Codelist\nSizeResolver" as CL
participant "Bisect\nCalculator" as B
participant "Availability\nProber\n<<callback>>" as PR
participant "Availability\nResponseParser" as P
participant "GenericRegistry\nAdapter" as A
participant "SeriesLimit\nTruncator" as T
database "BIS registry" as BIS

Client -> C : GET /data/.../key=*?limit=80
activate C
C -> C : translateDataQuery\n(reads supportsLimit=false,\nlimitEmulationTolerance=1.2,\nlimitEmulationProbeBudget=8)
C -> R : getData(query)
activate R

R -> R : supportsLimit=false\n  && limit=80\n  -> emulate

R -> L : getShrunkQuery(query, sdmxBeans,\n  prober = adapter::getAvailability)
activate L
L -> L : target = floor(80 * 1.2) = 96\n  budget = 8

== Step 0: TC fast-path (no probe) ==
loop for each non-time dim
  L -> CL : resolveSize(dim, sdmxBeans)
  CL --> L : OptionalInt
end
L -> L : TC = product of dim sizes

alt TC <= target
  L --> R : query.toBuilder.limit(null).build\n(no probe issued)
else TC > target or unresolvable
  == Step 1: Initial probe ==
  L -> PR : probe(availQuery0)
  PR -> A : getAvailability(...)
  A -> BIS : GET /availability/...
  BIS --> A : SDMX-JSON projections (raw)
  A --> PR : InputStream
  PR --> L : InputStream
  L -> P : parse(stream)
  P --> L : AvailabilityProjection\n{values, seriesCount=181}
  L -> L : M = 181, M > target -> bisect

  == Step 2: Bisect on REF_AREA, dimSize=64 ==
  L -> B : proportionalWarmStart(64, 181, 96)
  B --> L : k = 34
  L -> PR : probe(availQuery with c[REF_AREA]=v0..v33)
  PR -> A : getAvailability(...)
  A -> BIS : GET /availability/...
  BIS --> A : projections + seriesCount=100
  A --> PR : InputStream
  PR --> L : InputStream
  L -> P : parse(stream)
  P --> L : projection {seriesCount=100}
  L -> L : SC=100 > target=96 -> kHigh=34, lastOvershoot=100

  L -> B : proportionalReStep(34, 100, 96, 0, 34)
  B --> L : k = ceil(96 * 34 / 100) = 33
  L -> PR : probe(availQuery with c[REF_AREA]=v0..v32)
  PR -> A : getAvailability(...)
  A -> BIS : GET /availability/...
  BIS --> A : projections + seriesCount=96
  A --> PR : InputStream
  PR --> L : InputStream
  L -> P : parse(stream)
  P --> L : projection {seriesCount=96}
  L -> L : SC=96 in band [80, 96]\n  -> IN_BAND, lock at k=33

  == Build & return shrunk query ==
  note right of L
    shrunkQuery = query.toBuilder
      .filters({REF_AREA: [v0..v32]})  // 3.0
      .limit(null)
      .build()
  end note
  L --> R : TranslatedDataQuery
end

deactivate L

== Single data call (router) ==
R -> A : getData(shrunkQuery)
A -> BIS : GET /data/*?c[REF_AREA]=v0,...,v32...\n(no limit param)
BIS --> A : streaming data (~96 series)
A --> R : InputStream (raw)

== Truncation (router) ==
R -> T : truncate(raw, N=80, sdmxBeans)
T --> R : truncated stream (= 80 series)

== Fixtures + conversion (router) ==
R -> R : dataFixtureService.applyFixtures
R -> R : streamingDataConversionService.convert

R --> C : StreamingResponseBody
deactivate R

C --> Client : HTTP 200, exactly 80 series
deactivate C

note over R
  AdapterRouter owns every call to
  GenericRegistryAdapter -- both the
  availability probes (delegated by the
  prober callback) and the final getData
  on the shrunk query.
end note

@enduml
