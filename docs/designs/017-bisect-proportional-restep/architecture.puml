@startuml Heuristic Limit Emulation - Architecture

title Heuristic Limit Emulation - Component View

skinparam componentStyle rectangle
skinparam defaultTextAlignment center

package "sdmx-proxy (existing)" {
  [DataQuery30Controller] as ctrl
  [QueryTranslatorImpl] as qt
  [AdapterRouterImpl] as router
  [GenericRegistryAdapterImpl] as adapter
  [AvailabilityFixtureService] as availfixtures
  [DataFixtureService] as datafixtures
  [StreamingDataConversionService] as convert
  [DimensionService] as dims
}

package "sdmx-proxy: services.limit (new / modified)" #LightGreen {
  [LimitEmulationService\n(getShrunkQuery)] as svc
  [AvailabilityProber\n<<callback>>] as prober
  [AvailabilityResponseParser] as parser
  [BisectCalculator\n<<pure functions>>] as bisect
  [CodelistSizeResolver\n<<TC fast-path>>] as codelist
  [KeyParser] as keyparser
  [AvailabilityProjection\n<<record>>] as projection

  package "truncate" {
    [SeriesLimitTruncatorProvider] as provider
    [JsonDataV10SeriesLimitTruncator] as json10
    [JsonDataV20SeriesLimitTruncator] as json20
    [CsvSeriesLimitTruncator] as csv
    [XmlSeriesLimitTruncator] as xml
  }
}

package "sdmx-proxy-config (modified)" {
  [DataEndpointConfiguration\n+supportsLimit: boolean\n+limitEmulationTolerance: double\n+limitEmulationProbeBudget: int] as cfg
}

cloud "Upstream registry\n(BIS, IMF, ...)" as bis

ctrl --> qt : translateDataQuery
ctrl --> router : getData
qt ..> cfg : reads

router --> svc : getShrunkQuery\n(if !supportsLimit && limit != null)
router --> adapter : getData(passthrough OR shrunkQuery)
router --> provider : forFormat(returnFormat)
router --> datafixtures : applyFixtures (on truncated stream)
router --> convert

svc ..> prober : probe(availabilityQuery)
prober ..> adapter : delegated by router\n(genericRegistryAdapter::getAvailability)
svc --> availfixtures : applyFixtures (each probe)
svc --> parser : parse projection
svc --> bisect : proportionalWarmStart, proportionalReStep
svc --> codelist : resolveSize per dim (TC fast-path)
svc --> keyparser : parseKey / buildKey (2.1 path)
svc --> dims : getTimeDimensionId (excluded from bisect)
parser ..> projection : produces

provider --> json10 : JSON_1_0_0
provider --> json20 : JSON_DATA_2_0_0
provider --> csv : CSV_DATA_2_0_0
provider --> xml : XML_GENERICDATA_2_1\nXML_STRUCTURE_SPECIFIC_2_1

adapter --> bis

note right of svc
  Two-stage:
   1. TC fast-path via CodelistSizeResolver
      (no probe issued when TC <= target).
   2. Probe-budgeted multi-dim bisect:
      reverse DSD ordering (last dim first),
      proportional warm-start, then proportional
      re-step between kLow / kHigh; locks at
      kHigh on integer gap or budget exhaust.
  Returns TranslatedDataQuery with
  .limit(null). Never calls
  GenericRegistryAdapter directly --
  probes flow through AvailabilityProber.
end note

note right of router
  Owns every call to GenericRegistryAdapter:
   1. getShrunkQuery (with prober callback)
   2. adapter.getData(shrunkQuery)
   3. truncatorProvider.truncate(raw, n, beans)
   4. dataFixtureService.applyFixtures
   5. streamingDataConversionService.convert
end note

note bottom of bisect
  Pure-function helper, no I/O.
   - proportionalWarmStart(dimSize, m, target)
       = clamp(ceil(target*dimSize/m), 1, dimSize-1)
   - proportionalReStep(k, sc, target, kLow, kHigh)
       = clamp(ceil(target*k/sc), kLow+1, kHigh-1)
   Re-step replaces plain midpoint so step size
   scales with the magnitude of the latest probe's
   overshoot or undershoot.
end note

note bottom of codelist
  resolveSize(dim, beans) -> OptionalInt:
   reads dim.getRepresentation().getRepresentation()
   then sdmxBeans.getCodelists() filter by URN match.
   Empty when codelist absent -> caller falls
   back to probe path.
end note

note bottom of provider
  Lookup-by-format. No metrics,
  no startup validator -- if a
  registry's defaultFormat has
  no truncator, the first request
  fails loudly with a clear message.
end note

@enduml
