          "sdmxVersion": "SDMX_3_0",
          "structureEndpointConfig": {
            "url": "https://stats.bis.org/api/v2/structure/",
            "supportedFormats": [
              "JSON_STRUCTURE_2_0_0"
            ],
            "defaultFormat": "JSON_STRUCTURE_2_0_0",
            "bypassEnabled": false,
            "supportedStructures": [
              "datastructure",
              "conceptscheme",
              "codelist",
              "dataflow",
              "hierarchy",
              "hierarchyassociation"
            ]
          },
          "dataEndpointConfig": {
            "url": "https://stats.bis.org/api/v2/data/",
            "supportedFormats": [
              "JSON_1_0_0",
              "CSV_DATA_2_0_0"
            ],
            "defaultFormat": "JSON_1_0_0",
            "bypassEnabled": false,
            "mergeAllWildcardKey": true,
            "supportsLimit": false,
            "convertKeyToFilters": true,
            "fixtures": [
              {
                "type": "TIME_PERIOD_MONTHLY_NORMALIZATION",
                "config": {}
              }
            ]
          },
          "availabilityEndpointConfig": {
            "url": "https://stats.bis.org/api/v2/availability/",
