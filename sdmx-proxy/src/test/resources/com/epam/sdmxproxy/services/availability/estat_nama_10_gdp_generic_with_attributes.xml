<?xml version="1.0" encoding="UTF-8"?>
<!--
  A generic-data message carrying series-level Attributes, which have the same
  `Value id=... value=...` shape as a SeriesKey's dimension values. ECB answers detail=nodata
  this way.

  The harvester must record only what is inside SeriesKey. Folding the Attributes in would report
  attribute values (OBS_STATUS=A, TIME_FORMAT=P1Y) as dimension coverage - and because the
  emulated response is what the consumer indexes as `available_values`, a bogus code there raises
  a KeyError later, far from the cause.
-->
<m:GenericData xmlns:m="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/message"
               xmlns:c="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/common"
               xmlns:g="http://www.sdmx.org/resources/sdmxml/schemas/v2_1/data/generic">
    <m:Header>
        <m:ID>ATTRS1</m:ID>
        <m:Test>false</m:Test>
        <m:Sender id="ESTAT"/>
        <m:DataSetID>NAMA_10_GDP</m:DataSetID>
    </m:Header>
    <m:DataSet structureRef="STR1">
        <g:Series>
            <g:SeriesKey>
                <g:Value id="geo" value="AT"/>
                <g:Value id="na_item" value="B1GQ"/>
                <g:Value id="unit" value="CLV05_MEUR"/>
                <g:Value id="freq" value="A"/>
            </g:SeriesKey>
            <g:Attributes>
                <g:Value id="OBS_STATUS" value="A"/>
                <g:Value id="TIME_FORMAT" value="P1Y"/>
                <g:Value id="geo" value="NOT_A_DIMENSION_VALUE"/>
            </g:Attributes>
        </g:Series>
    </m:DataSet>
</m:GenericData>
